# ---------------------------------------------------------------------------
# copy to `.env` and edit. Everything here is optional except OPENAI_API_KEY.
# ---------------------------------------------------------------------------

# --- LLM: any OpenAI-compatible chat-completions endpoint -------------------
# DeepSeek:  https://api.deepseek.com/v1
# OpenAI:    https://api.openai.com/v1   (or leave BASE_URL unset)
# vLLM:      http://localhost:8000/v1
# Ollama:    http://localhost:11434/v1
OPENAI_API_KEY=sk-your-key-here
# 也接受 DEEPSEEK_API_KEY（未设置 OPENAI_API_KEY 时自动使用）
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 需求分析 / 参数提取 使用的模型
ANALYST_MODEL=deepseek-v4-flash
# 代码生成 / 代码纠错 使用的模型
CODER_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120

# --- knowledge retrieval ----------------------------------------------------
# relative paths are resolved against the project root
KB_PATH=kb/jwave_kb_organized.md
# bm25   = offline lexical search (default, no extra deps)
# openai = OpenAI-compatible embeddings + in-memory vector store
RETRIEVAL_BACKEND=bm25
RETRIEVAL_TOP_K=4
EMBEDDING_MODEL=text-embedding-3-small

# --- code execution (replacement for the RUN_PYTHON_CODE MCP tool) ----------
# subprocess (default) | jupyter | mcp | auto
EXECUTOR_BACKEND=subprocess
# interpreter used to run the generated scripts; empty = same interpreter
EXEC_PYTHON=
EXEC_TIMEOUT=600
WORKDIR=run

# --- workflow ---------------------------------------------------------------
LOOP_MAX_ITERATIONS=10
VERBOSE=1
